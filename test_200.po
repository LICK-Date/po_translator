# Label for starting a fresh playthrough
#: src/ui/menu.py:12
msgid "Start New Game"
msgstr "开始新游戏"

# Continue from the latest auto/manual save
#: src/ui/menu.py:13
msgid "Continue"
msgstr "继续"

# Open the saved games list
#: src/ui/menu.py:14
msgid "Load Saved Game"
msgstr "加载存档"

# Save current state
#: src/ui/menu.py:15
msgid "Save Game"
msgstr "保存游戏"

# Header or indicator for automatic save
#: src/ui/menu.py:16
msgid "Auto Save"
msgstr "自动保存"

# Shortcut button for quick save
#: src/ui/menu.py:17
msgid "Quick Save"
msgstr "快速保存"

# Access application settings
#: src/ui/menu.py:18
msgid "Settings & Options"
msgstr "设置与选项"

# Sound volume and audio output
#: src/ui/menu.py:19
msgid "Audio Settings"
msgstr "音频设置"

# Display resolutions, shadows, textures
#: src/ui/menu.py:20
msgid "Video & Graphics"
msgstr "视频与图形"

# Difficulty, hints, camera speed
#: src/ui/menu.py:21
msgid "Gameplay Settings"
msgstr "游戏玩法设置"

# Keyboard bindings and gamepad layout
#: src/ui/menu.py:22
msgid "Control Settings"
msgstr "控制设置"

# Localization options
#: src/ui/menu.py:23
msgid "Language & Region"
msgstr "语言与地区"

# Staff and contributor credits
#: src/ui/menu.py:24
msgid "Credits"
msgstr "制作人员"

# FAQ and player support links
#: src/ui/menu.py:25
msgid "Help & Support"
msgstr "帮助与支持"

# Report an issue to developers
#: src/ui/menu.py:26
msgid "Feedback & Bug Report"
msgstr "反馈与错误报告"

# Network update check
#: src/ui/menu.py:27
msgid "Check for Updates"
msgstr "检查更新"

# App version and license information
#: src/ui/menu.py:28
msgid "About TranslateAgent"
msgstr "关于 TranslateAgent"

# Quit the entire application
#: src/ui/menu.py:29
msgid "Exit to Desktop"
msgstr "退出到桌面"

# Leave the current match or game session
#: src/ui/menu.py:30
msgid "Return to Main Menu"
msgstr "返回主菜单"

# Pause gameplay screen
#: src/ui/menu.py:31
msgid "Pause Game"
msgstr "暂停游戏"

# Resume gameplay
#: src/ui/menu.py:32
msgid "Resume"
msgstr "继续"

# Restart current level from beginning
#: src/ui/menu.py:33
msgid "Restart Mission"
msgstr "重新开始任务"

# Generic confirmation button
#: src/ui/common.py:10
msgid "Confirm"
msgstr "确认"

# Generic cancellation button
#: src/ui/common.py:11
msgid "Cancel"
msgstr "取消"

# Apply modified settings
#: src/ui/common.py:12
msgid "Apply Changes"
msgstr "应用更改"

# Reset settings to initial defaults
#: src/ui/common.py:13
msgid "Reset to Default"
msgstr "重置为默认"

# Navigate back
#: src/ui/common.py:14
msgid "Back"
msgstr "返回"

# Navigate forward
#: src/ui/common.py:15
msgid "Next"
msgstr "下一个"

# Navigate to previous page
#: src/ui/common.py:16
msgid "Previous"
msgstr "上一个"

# Close current popup dialog
#: src/ui/common.py:17
msgid "Close"
msgstr "关闭"

# Player level display
#: src/hud/stats.py:40
#, c-format
msgid "Level %d"
msgstr "等级 %d"

# Health points current/max
#: src/hud/stats.py:41
#, c-format
msgid "HP: %d / %d"
msgstr "生命值: %d / %d"

# Mana points current/max
#: src/hud/stats.py:42
#, c-format
msgid "MP: %d / %d"
msgstr "魔法值: %d / %d"

# Stamina percentage
#: src/hud/stats.py:43
#, c-format
msgid "Stamina: %d%%"
msgstr "耐力: %d%%"

# EXP progress
#: src/hud/stats.py:44
#, c-format
msgid "Experience: %d / %d"
msgstr "经验值：%d / %d"

# Physical damage rating
#: src/hud/stats.py:45
msgid "Attack Power"
msgstr "攻击力"

# Damage mitigation rating
#: src/hud/stats.py:46
msgid "Defense Rating"
msgstr "防御等级"

# Magical damage reduction
#: src/hud/stats.py:47
msgid "Magic Resistance"
msgstr "魔法抗性"

# Crit percentage
#: src/hud/stats.py:48
#, c-format
msgid "Critical Hit Chance: %.1f%%"
msgstr "暴击几率：%.1f%%"

# Hero move speed stat
#: src/hud/stats.py:49
msgid "Movement Speed"
msgstr "移动速度"

# Unused skill points
#: src/hud/stats.py:50
#, c-format
msgid "Available Skill Points: %d"
msgstr "可用技能点：%d"

# Player currency counter
#: src/hud/stats.py:51
#, c-format
msgid "Gold: %s"
msgstr "金币：%s"

# Warning when bags are full
#: src/hud/inventory.py:88
#, c-format
msgid "Inventory full! Cannot pick up %s."
msgstr "背包已满！无法拾取 %s。"

# Level up celebration
#: src/entities/player.py:120
#, c-format
msgid "Level Up! You gained %d attribute points."
msgstr "升级！你获得了 %d 点属性点。"

# Banner when quest ends
#: src/quests/tracker.py:65
#, c-format
msgid "Quest Completed: %s"
msgstr "任务完成：%s"

# Banner for newly unlocked quest
#: src/quests/tracker.py:66
#, c-format
msgid "New Quest Available: %s"
msgstr "新任务可接取：%s"

# Tracker update text
#: src/quests/tracker.py:67
#, c-format
msgid "Objective Updated: %s"
msgstr "目标已更新：%s"

# Defense arena wave counter
#: src/combat/arena.py:34
#, c-format
msgid "Wave %d / %d"
msgstr "第 %d / %d 波"

# Mission instruction
#: src/combat/arena.py:35
msgid "Defeat all incoming enemies!"
msgstr "击败所有来袭的敌人！"

# Boss spawn alert
#: src/combat/arena.py:36
msgid "Boss incoming! Prepare for battle."
msgstr "Boss 来袭！准备战斗。"

# Countdown timer mm:ss
#: src/hud/timer.py:22
#, c-format
msgid "Time Remaining: %02d:%02d"
msgstr "剩余时间：%02d:%02d"

# Multi-hit combo notification
#: src/combat/hit.py:89
#, c-format
msgid "Combo x%d!"
msgstr "连击 x%d！"

# Floats over target on crit
#: src/combat/hit.py:90
msgid "Critical Strike!"
msgstr "暴击！"

# Floats over player on dodge
#: src/combat/hit.py:91
msgid "Dodged!"
msgstr "闪避！"

# Floats over shield on block
#: src/combat/hit.py:92
msgid "Blocked!"
msgstr "格挡！"

# Restores %d HP instantly.
#: src/items/consumables.py:10
msgid "Health Potion"
msgstr "生命药水"

# Restores %d MP over %d seconds.
#: src/items/consumables.py:15
msgid "Mana Elixir"
msgstr "法力药剂"

# A sturdy steel blade forged by village blacksmiths.
#: src/items/weapons.py:20
msgid "Iron Longsword"
msgstr "铁制长剑"

# Increases physical defense by %d and fire resistance by %d%%.
#: src/items/armor.py:30
msgid "Dragon Scale Shield"
msgstr "龙鳞盾"

# Fires swift arrows with deadly accuracy from afar.
#: src/items/weapons.py:40
msgid "Elven Bow"
msgstr "精灵弓"

# Increases spell casting speed by %d%% and maximum mana.
#: src/items/accessories.py:50
msgid "Ring of Wisdom"
msgstr "智慧之戒"

# A mysterious artifact inscribed with forgotten ancient runes.
#: src/items/quest_items.py:60
msgid "Ancient Relic"
msgstr "远古遗物"

# Increases movement speed by %d%% and reduces fall damage.
#: src/items/armor.py:70
msgid "Leather Boots"
msgstr "皮靴"

# A fragrant plant that can be brewed into curative potions.
#: src/items/materials.py:80
msgid "Healing Herb"
msgstr "治疗草药"

# Unleashes a blazing ball of fire dealing %d fire damage.
#: src/items/scrolls.py:90
msgid "Magic Scroll: Fireball"
msgstr "魔法卷轴：火球"

# Opens a locked heavy iron door in the catacombs.
#: src/items/keys.py:100
msgid "Rusty Dungeon Key"
msgstr "生锈的地牢钥匙"

# An exquisite treasure retrieved from royal ancient ruins.
#: src/items/valuables.py:110
msgid "Golden Chalice"
msgstr "黄金圣杯"

# Creates a dense cloud of smoke allowing instant combat escape.
#: src/items/consumables.py:120
msgid "Smoke Bomb"
msgstr "烟雾弹"

# Inflicts %d poison damage per second for %d seconds.
#: src/items/weapons.py:130
msgid "Poison Dart"
msgstr "毒镖"

# A simple travel ration that slowly restores stamina.
#: src/items/food.py:140
msgid "Ration Bread"
msgstr "配给面包"

# Teaches how to craft the designated item.
#: src/items/recipes.py:150
#, c-format
msgid "Crafting Recipe: %s"
msgstr "制作配方：%s"

# Lists ingredients needed for blacksmith synthesis.
#: src/items/recipes.py:151
#, c-format
msgid "Required Materials: %s"
msgstr "所需材料：%s"

# Equip selected weapon or gear to hero.
#: src/ui/inventory.py:200
msgid "Equip Item"
msgstr "装备物品"

# Remove selected equipment back into backpack.
#: src/ui/inventory.py:201
msgid "Unequip Item"
msgstr "卸下物品"

# Consume the selected consumable immediately.
#: src/ui/inventory.py:202
msgid "Use Item"
msgstr "使用物品"

# Drop item on the ground in current world map.
#: src/ui/inventory.py:203
msgid "Drop Item"
msgstr "丢弃物品"

# Destroy the selected item permanently from inventory.
#: src/ui/inventory.py:204
msgid "Discard Permanently"
msgstr "永久丢弃"

# Sell selected items for gold coins.
#: src/ui/inventory.py:205
msgid "Sell to Merchant"
msgstr "卖给商人"

# Purchase goods from merchant stock.
#: src/ui/inventory.py:206
msgid "Buy from Merchant"
msgstr "从商人处购买"

# Enhance gear stats using upgrade stones and gold.
#: src/ui/blacksmith.py:210
msgid "Upgrade Equipment"
msgstr "升级装备"

# Combat skill tooltip description
#: src/skills/database.py:100
#, c-format
msgid "Fireball: Launch a fiery projectile dealing %d fire damage."
msgstr "火球：发射一枚火焰弹，造成 %d 点火焰伤害。"

# Combat skill tooltip description
#: src/skills/database.py:105
#, c-format
msgid "Frost Nova: Freezes all nearby enemies for %.1f seconds."
msgstr "冰霜新星：冻结附近所有敌人，持续 %.1f 秒。"

# Combat skill tooltip description
#: src/skills/database.py:110
msgid ""
"Lightning Strike: Calls down a powerful bolt of lightning upon the target."
msgstr "闪电打击：召唤一道强大的闪电劈向目标。"

# Combat skill tooltip description
#: src/skills/database.py:115
msgid ""
"Whirlwind: Spin rapidly with your two-handed weapon, striking all nearby "
"foes."
msgstr "旋风斩：用双手武器快速旋转，攻击附近所有敌人。"

# Combat skill tooltip description
#: src/skills/database.py:120
msgid "Shadow Step: Teleport instantly behind your targeted enemy."
msgstr "暗影步：立即传送到目标敌人身后。"

# Combat skill tooltip description
#: src/skills/database.py:125
#, c-format
msgid ""
"Divine Shield: Grants complete invulnerability to all damage for %d seconds."
msgstr "神圣护盾：使目标完全免疫所有伤害，持续 %d 秒。"

# Combat skill tooltip description
#: src/skills/database.py:130
#, c-format
msgid "Battle Shout: Boosts allies' attack power by %d%% for %d seconds."
msgstr "战斗怒吼：使盟友的攻击强度提高 %d%%，持续 %d 秒。"

# Combat skill tooltip description
#: src/skills/database.py:135
msgid "Stealth: Become invisible to monsters until your next melee attack."
msgstr "潜行：对怪物隐形，直到你下一次近战攻击。"

# Combat skill tooltip description
#: src/skills/database.py:140
msgid "Poison Arrow: Shoots an arrow coated in deadly serpent toxin."
msgstr "毒箭：射出一支涂有致命蛇毒的箭。"

# Combat skill tooltip description
#: src/skills/database.py:145
msgid "Meteor Shower: Summons burning cosmic fragments across a wide area."
msgstr "流星火雨：在广阔区域内召唤燃烧的宇宙碎片。"

# Combat skill tooltip description
#: src/skills/database.py:150
#, c-format
msgid "Resurrection: Brings a fallen teammate back to life with %d%% health."
msgstr "复活：使一名倒下的队友复活，并拥有 %d%% 生命值。"

# Combat skill tooltip description
#: src/skills/database.py:155
#, c-format
msgid "Taunt: Forces surrounding monsters to attack you for %d seconds."
msgstr "嘲讽：迫使周围的怪物攻击你，持续 %d 秒。"

# Combat skill tooltip description
#: src/skills/database.py:160
msgid "Berserk: Greatly increase attack speed at the cost of defense."
msgstr "狂暴：以牺牲防御为代价，大幅提高攻击速度。"

# Combat skill tooltip description
#: src/skills/database.py:165
#, c-format
msgid "Chain Lightning: Electrical arc jumps between up to %d nearby targets."
msgstr "连锁闪电：电弧在最多 %d 个附近目标之间跳跃。"

# Combat skill tooltip description
#: src/skills/database.py:170
#, c-format
msgid ""
"Blizzard: Freezes the target zone, slowing enemy movement speed by %d%%."
msgstr "暴风雪：冻结目标区域，使敌人移动速度降低 %d%%。"

# Combat skill tooltip description
#: src/skills/database.py:175
#, c-format
msgid ""
"Earthquake: Tremors rock the ground, knocking down enemies for %d seconds."
msgstr "地震：大地剧烈震动，击倒敌人 %d 秒。"

# Combat skill tooltip description
#: src/skills/database.py:180
#, c-format
msgid "Sprint: Increases running speed by %d%% for %d seconds."
msgstr "疾跑：在 %d 秒内提高奔跑速度 %d%%。"

# Combat skill tooltip description
#: src/skills/database.py:185
msgid "Blade Dance: Perform a rapid sequence of 5 precise strikes."
msgstr "剑刃之舞：快速施展一连串 5 次精准打击。"

# Combat skill tooltip description
#: src/skills/database.py:190
#, c-format
msgid ""
"Holy Light: Channels celestial light to heal the target ally for %d HP."
msgstr "圣光：引导神圣之光，为目标盟友恢复 %d 点生命值。"

# Combat skill tooltip description
#: src/skills/database.py:195
#, c-format
msgid "Life Drain: Siphons %d HP from enemy to replenish your own health."
msgstr "生命汲取：从敌人身上吸取 %d 点生命值来补充自身生命。"

# Combat skill tooltip description
#: src/skills/database.py:200
msgid ""
"Mana Shield: Diverts incoming damage to consume mana instead of health."
msgstr "法力护盾：将受到的伤害转化为消耗法力，而非生命值。"

# Combat skill tooltip description
#: src/skills/database.py:205
#, c-format
msgid "Silent Step: Reduces footstep and equipment noise by %d%%."
msgstr "寂静步伐：降低脚步声和装备噪音 %d%%。"

# Combat skill tooltip description
#: src/skills/database.py:210
msgid "Summon Familiar: Conjures an arcane companion to assist in battle."
msgstr "召唤魔宠：召唤一个奥术伙伴协助战斗。"

# Combat skill tooltip description
#: src/skills/database.py:215
msgid "Arcane Blast: Discharges raw concentrated magical energy at target."
msgstr "奥术冲击：向目标释放凝聚的原始魔法能量。"

# Combat skill tooltip description
#: src/skills/database.py:220
#, c-format
msgid ""
"Piercing Shot: Shoots a heavy bolt that pierces through up to %d enemies."
msgstr "穿刺射击：射出一支重型弩箭，最多可穿透 %d 名敌人。"

# NPC dialogue line categorized under context 'greeting'
#: src/dialogue/npc_conversations.py:200
msgctxt "greeting"
msgid "Greetings, traveler! What brings you to our humble settlement?"
msgstr "你好，旅行者！是什么风把你吹到我们这个不起眼的小村落？"

# NPC dialogue line categorized under context 'greeting'
#: src/dialogue/npc_conversations.py:204
msgctxt "greeting"
msgid "Safe travels, adventurer! Watch your step in the dark woods."
msgstr "一路平安，冒险者！在黑暗的森林里小心脚下。"

# NPC dialogue line categorized under context 'greeting'
#: src/dialogue/npc_conversations.py:208
msgctxt "greeting"
msgid "Welcome back! The village elder has been asking for you."
msgstr "欢迎回来！村长一直在找你。"

# NPC dialogue line categorized under context 'farewell'
#: src/dialogue/npc_conversations.py:212
msgctxt "farewell"
msgid "Farewell, and may the wind be ever at your back."
msgstr "再会，愿风永远伴你左右。"

# NPC dialogue line categorized under context 'farewell'
#: src/dialogue/npc_conversations.py:216
msgctxt "farewell"
msgid "Until we meet again under the shining stars."
msgstr "愿我们在璀璨星空下再度重逢。"

# NPC dialogue line categorized under context 'farewell'
#: src/dialogue/npc_conversations.py:220
msgctxt "farewell"
msgid "Stay alert. The night is dark and full of dangers."
msgstr "保持警惕。黑夜漫漫，危机四伏。"

# NPC dialogue line categorized under context 'merchant'
#: src/dialogue/npc_conversations.py:224
msgctxt "merchant"
msgid "Looking to buy or sell today? I have the finest goods around."
msgstr "今天想买点什么还是卖点什么？我这有最好的货物。"

# NPC dialogue line categorized under context 'merchant'
#: src/dialogue/npc_conversations.py:228
msgctxt "merchant"
msgid "You cannot afford this item right now. Come back with more gold!"
msgstr "你现在的钱买不起这件物品。多带点金币再来吧！"

# NPC dialogue line categorized under context 'merchant'
#: src/dialogue/npc_conversations.py:232
msgctxt "merchant"
msgid "A pleasure doing business with you, brave hero."
msgstr "很高兴与你做生意，勇敢的英雄。"

# NPC dialogue line categorized under context 'blacksmith'
#: src/dialogue/npc_conversations.py:236
msgctxt "blacksmith"
msgid "Bring me five iron ingots and I will forge you an invincible blade."
msgstr "给我带五块铁锭来，我就为你锻造一把无敌的利刃。"

# NPC dialogue line categorized under context 'blacksmith'
#: src/dialogue/npc_conversations.py:240
msgctxt "blacksmith"
msgid "The steel must be tempered with fire and cooled in dragon blood."
msgstr "这钢材必须以烈火淬炼，再用龙血冷却。"

# NPC dialogue line categorized under context 'blacksmith'
#: src/dialogue/npc_conversations.py:244
msgctxt "blacksmith"
msgid "Your weapon is badly damaged; let me repair it before you depart."
msgstr "你的武器损坏严重；在你出发前让我修好它。"

# NPC dialogue line categorized under context 'guard'
#: src/dialogue/npc_conversations.py:248
msgctxt "guard"
msgid "Halt! Who goes there? State your business in the capital city."
msgstr "站住！来者何人？说明你在首都的事务。"

# NPC dialogue line categorized under context 'guard'
#: src/dialogue/npc_conversations.py:252
msgctxt "guard"
msgid "Move along, citizen. Keep your weapons sheathed within the gates."
msgstr "走吧，市民。在城门之内请将武器收鞘。"

# NPC dialogue line categorized under context 'guard'
#: src/dialogue/npc_conversations.py:256
msgctxt "guard"
msgid ""
"Report any suspicious activities to the garrison guardhouse immediately."
msgstr "如发现任何可疑活动，请立即向卫戍警卫室报告。"

# NPC dialogue line categorized under context 'innkeeper'
#: src/dialogue/npc_conversations.py:260
#, c-format
msgctxt "innkeeper"
msgid "A hot meal and a soft bed will cost you %d copper coins."
msgstr "一顿热饭和一张软床需要花费你 %d 枚铜币。"

# NPC dialogue line categorized under context 'innkeeper'
#: src/dialogue/npc_conversations.py:264
msgctxt "innkeeper"
msgid "Sit by the hearth and rest your weary bones for a while."
msgstr "坐在炉火旁，让你疲惫的身躯休息一会儿。"

# NPC dialogue line categorized under context 'quest_elder'
#: src/dialogue/npc_conversations.py:268
msgctxt "quest_elder"
msgid "Our sacred relic was stolen by bandits from the northern mountains."
msgstr "我们的圣物被来自北方山区的强盗偷走了。"

# NPC dialogue line categorized under context 'quest_elder'
#: src/dialogue/npc_conversations.py:272
msgctxt "quest_elder"
msgid "Please bring peace back to our land before the red eclipse begins."
msgstr "请在红月食开始之前，为我们的土地重新带来和平。"

# NPC dialogue line categorized under context 'quest_elder'
#: src/dialogue/npc_conversations.py:276
msgctxt "quest_elder"
msgid "You have done what no ordinary mortal could achieve. Take this reward."
msgstr "你完成了凡人无法企及的壮举。收下这份奖赏吧。"

# NPC dialogue line categorized under context 'alchemist'
#: src/dialogue/npc_conversations.py:280
msgctxt "alchemist"
msgid "Careful with that vial! One wrong drop could blow up the entire lab."
msgstr "小心那个瓶子！滴错一滴就可能炸毁整个实验室。"

# NPC dialogue line categorized under context 'alchemist'
#: src/dialogue/npc_conversations.py:284
msgctxt "alchemist"
msgid "I need rare red mushrooms that only grow near the volcanic vents."
msgstr "我需要只生长在火山喷口附近的稀有红蘑菇。"

# NPC dialogue line categorized under context 'scholar'
#: src/dialogue/npc_conversations.py:288
msgctxt "scholar"
msgid ""
"The ancient inscriptions speak of a forgotten kingdom beneath the sands."
msgstr "古老的铭文提到了沙丘之下一个被遗忘的王国。"

# NPC dialogue line categorized under context 'scholar'
#: src/dialogue/npc_conversations.py:292
msgctxt "scholar"
msgid "Knowledge is a sharper blade than any steel sword, young traveler."
msgstr "知识是比任何钢剑都更锋利的刀刃，年轻的旅行者。"

# NPC dialogue line categorized under context 'villager'
#: src/dialogue/npc_conversations.py:296
msgctxt "villager"
msgid "Have you seen my pet cat? She ran towards the haunted cemetery."
