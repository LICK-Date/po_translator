# Combat skill tooltip description
#: src/skills/database.py:100
#, c-format
msgid "Fireball: Launch a fiery projectile dealing %d fire damage."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:105
#, c-format
msgid "Frost Nova: Freezes all nearby enemies for %.1f seconds."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:110
msgid ""
"Lightning Strike: Calls down a powerful bolt of lightning upon the target."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:115
msgid ""
"Whirlwind: Spin rapidly with your two-handed weapon, striking all nearby "
"foes."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:120
msgid "Shadow Step: Teleport instantly behind your targeted enemy."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:125
#, c-format
msgid ""
"Divine Shield: Grants complete invulnerability to all damage for %d seconds."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:130
#, c-format
msgid "Battle Shout: Boosts allies' attack power by %d%% for %d seconds."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:135
msgid "Stealth: Become invisible to monsters until your next melee attack."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:140
msgid "Poison Arrow: Shoots an arrow coated in deadly serpent toxin."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:145
msgid "Meteor Shower: Summons burning cosmic fragments across a wide area."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:150
#, c-format
msgid "Resurrection: Brings a fallen teammate back to life with %d%% health."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:155
#, c-format
msgid "Taunt: Forces surrounding monsters to attack you for %d seconds."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:160
msgid "Berserk: Greatly increase attack speed at the cost of defense."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:165
#, c-format
msgid "Chain Lightning: Electrical arc jumps between up to %d nearby targets."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:170
#, c-format
msgid ""
"Blizzard: Freezes the target zone, slowing enemy movement speed by %d%%."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:175
#, c-format
msgid ""
"Earthquake: Tremors rock the ground, knocking down enemies for %d seconds."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:180
#, c-format
msgid "Sprint: Increases running speed by %d%% for %d seconds."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:185
msgid "Blade Dance: Perform a rapid sequence of 5 precise strikes."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:190
#, c-format
msgid ""
"Holy Light: Channels celestial light to heal the target ally for %d HP."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:195
#, c-format
msgid "Life Drain: Siphons %d HP from enemy to replenish your own health."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:200
msgid ""
"Mana Shield: Diverts incoming damage to consume mana instead of health."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:205
#, c-format
msgid "Silent Step: Reduces footstep and equipment noise by %d%%."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:210
msgid "Summon Familiar: Conjures an arcane companion to assist in battle."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:215
msgid "Arcane Blast: Discharges raw concentrated magical energy at target."
msgstr ""

# Combat skill tooltip description
#: src/skills/database.py:220
#, c-format
msgid ""
"Piercing Shot: Shoots a heavy bolt that pierces through up to %d enemies."
msgstr ""

# NPC dialogue line categorized under context 'greeting'
#: src/dialogue/npc_conversations.py:200
msgctxt "greeting"
msgid "Greetings, traveler! What brings you to our humble settlement?"
msgstr ""

# NPC dialogue line categorized under context 'greeting'
#: src/dialogue/npc_conversations.py:204
msgctxt "greeting"
msgid "Safe travels, adventurer! Watch your step in the dark woods."
msgstr ""

# NPC dialogue line categorized under context 'greeting'
#: src/dialogue/npc_conversations.py:208
msgctxt "greeting"
msgid "Welcome back! The village elder has been asking for you."
msgstr ""

# NPC dialogue line categorized under context 'farewell'
#: src/dialogue/npc_conversations.py:212
msgctxt "farewell"
msgid "Farewell, and may the wind be ever at your back."
msgstr ""

# NPC dialogue line categorized under context 'farewell'
#: src/dialogue/npc_conversations.py:216
msgctxt "farewell"
msgid "Until we meet again under the shining stars."
msgstr ""

# NPC dialogue line categorized under context 'farewell'
#: src/dialogue/npc_conversations.py:220
msgctxt "farewell"
msgid "Stay alert. The night is dark and full of dangers."
msgstr ""

# NPC dialogue line categorized under context 'merchant'
#: src/dialogue/npc_conversations.py:224
msgctxt "merchant"
msgid "Looking to buy or sell today? I have the finest goods around."
msgstr ""

# NPC dialogue line categorized under context 'merchant'
#: src/dialogue/npc_conversations.py:228
msgctxt "merchant"
msgid "You cannot afford this item right now. Come back with more gold!"
msgstr ""

# NPC dialogue line categorized under context 'merchant'
#: src/dialogue/npc_conversations.py:232
msgctxt "merchant"
msgid "A pleasure doing business with you, brave hero."
msgstr ""

# NPC dialogue line categorized under context 'blacksmith'
#: src/dialogue/npc_conversations.py:236
msgctxt "blacksmith"
msgid "Bring me five iron ingots and I will forge you an invincible blade."
msgstr ""

# NPC dialogue line categorized under context 'blacksmith'
#: src/dialogue/npc_conversations.py:240
msgctxt "blacksmith"
msgid "The steel must be tempered with fire and cooled in dragon blood."
msgstr ""

# NPC dialogue line categorized under context 'blacksmith'
#: src/dialogue/npc_conversations.py:244
msgctxt "blacksmith"
msgid "Your weapon is badly damaged; let me repair it before you depart."
msgstr ""

# NPC dialogue line categorized under context 'guard'
#: src/dialogue/npc_conversations.py:248
msgctxt "guard"
msgid "Halt! Who goes there? State your business in the capital city."
msgstr ""

# NPC dialogue line categorized under context 'guard'
#: src/dialogue/npc_conversations.py:252
msgctxt "guard"
msgid "Move along, citizen. Keep your weapons sheathed within the gates."
msgstr ""

# NPC dialogue line categorized under context 'guard'
#: src/dialogue/npc_conversations.py:256
msgctxt "guard"
msgid ""
"Report any suspicious activities to the garrison guardhouse immediately."
msgstr ""

# NPC dialogue line categorized under context 'innkeeper'
#: src/dialogue/npc_conversations.py:260
#, c-format
msgctxt "innkeeper"
msgid "A hot meal and a soft bed will cost you %d copper coins."
msgstr ""

# NPC dialogue line categorized under context 'innkeeper'
#: src/dialogue/npc_conversations.py:264
msgctxt "innkeeper"
msgid "Sit by the hearth and rest your weary bones for a while."
msgstr ""

# NPC dialogue line categorized under context 'quest_elder'
#: src/dialogue/npc_conversations.py:268
msgctxt "quest_elder"
msgid "Our sacred relic was stolen by bandits from the northern mountains."
msgstr ""

# NPC dialogue line categorized under context 'quest_elder'
#: src/dialogue/npc_conversations.py:272
msgctxt "quest_elder"
msgid "Please bring peace back to our land before the red eclipse begins."
msgstr ""

# NPC dialogue line categorized under context 'quest_elder'
#: src/dialogue/npc_conversations.py:276
msgctxt "quest_elder"
msgid "You have done what no ordinary mortal could achieve. Take this reward."
msgstr ""

# NPC dialogue line categorized under context 'alchemist'
#: src/dialogue/npc_conversations.py:280
msgctxt "alchemist"
msgid "Careful with that vial! One wrong drop could blow up the entire lab."
msgstr ""

# NPC dialogue line categorized under context 'alchemist'
#: src/dialogue/npc_conversations.py:284
msgctxt "alchemist"
msgid "I need rare red mushrooms that only grow near the volcanic vents."
msgstr ""

# NPC dialogue line categorized under context 'scholar'
#: src/dialogue/npc_conversations.py:288
msgctxt "scholar"
msgid ""
"The ancient inscriptions speak of a forgotten kingdom beneath the sands."
msgstr ""

# NPC dialogue line categorized under context 'scholar'
#: src/dialogue/npc_conversations.py:292
msgctxt "scholar"
msgid "Knowledge is a sharper blade than any steel sword, young traveler."
msgstr ""

# NPC dialogue line categorized under context 'villager'
#: src/dialogue/npc_conversations.py:296
msgctxt "villager"
msgid "Have you seen my pet cat? She ran towards the haunted cemetery."
msgstr ""

