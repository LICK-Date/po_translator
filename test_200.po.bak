# Italic and bold gameplay tip
#: src/ui/rich_labels.py:70
msgid ""
"Elemental Combo: Fuse <i>Fire</i> and <i>Wind</i> to unleash a "
"<b>Firestorm</b>!"
msgstr ""

# CSS span tag and bold time
#: src/ui/rich_labels.py:75
#, c-format
msgid ""
"<span class=\"alert\">Notice:</span> Maintenance will start at <b>%s "
"UTC</b>."
msgstr ""

# Font color and rankings
#: src/ui/rich_labels.py:80
#, c-format
msgid "Leaderboard #%d: <font color=\"gold\">%s</font> achieved score %d!"
msgstr ""

# Escaped backslash path
#: src/ui/rich_labels.py:85
#, c-format
msgid "Default installation target folder: <code>%s\\TranslateAgent\\data</code>"
msgstr ""

# Brace placeholders in HTML
#: src/ui/rich_labels.py:90
#, python-brace-format
msgid "Your score: <b>{score}</b> | Global All-Time High: <b>{high_score}</b>"
msgstr ""

# Button input tags
#: src/ui/rich_labels.py:95
msgid ""
"Hold <button>Space</button> to jump or tap <button>Shift</button> to dodge."
msgstr ""

# Mathematical formula code block
#: src/ui/rich_labels.py:100
#, c-format
msgid ""
"Damage Calculation: <code>Damage = (Attack * %d) - (Defense / %d)</code>"
msgstr ""

