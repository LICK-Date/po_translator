#: src/menu.py:12
msgid "Start New Game"
msgstr "开始新游戏"

#: src/menu.py:13
msgid "Load Saved Game"
msgstr "加载存档"

#: src/menu.py:14
msgid "Settings & Options"
msgstr "设置与选项"

#: src/menu.py:15
msgid "Exit to Desktop"
msgstr "退出到桌面"

#. Developer Note: Notification when a warrior levels up
#: src/entities/player.py:105
#, c-format
msgid "Hero %s has reached Level %d!"
msgstr "英雄 %s 已达到等级 %d！"

#. Developer Note: Inventory reward message
#: src/items/chest.py:44
msgid ""
"You opened the ancient chest and acquired ${gold_amount} Gold and "
"{{item_name}}!"
msgstr ""

#: src/ui/hud.py:58
msgid "Welcome back, {player_name}! You have {quest_count} active quests."
msgstr "欢迎回来，{player_name}！你当前有 {quest_count} 个进行中的任务。"

#: src/network/dialog.py:89
#, c-format
msgid "Click <a href=\"%s\">here</a> to read the latest patch notes."
msgstr "点击<a href=\"%s\">此处</a>阅读最新补丁说明。"

#: src/dialogue/npc.py:21
msgctxt "greeting"
msgid "Safe travels, adventurer!"
msgstr "祝你一路顺风，冒险家！"

#: src/dialogue/npc.py:22
msgctxt "farewell"
msgid "Until we meet again under the stars."
msgstr "愿我们在群星之下再次相逢。"

#: src/combat/spell.py:77
msgid "Critical Hit! Dealt %d damage to [ENEMY]."
msgstr "暴击！对 [ENEMY] 造成了 %d 点伤害。"
